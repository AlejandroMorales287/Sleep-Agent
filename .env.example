# Copy this file to .env and fill in your key. Every setting below is optional
# except ANTHROPIC_API_KEY; the values shown are the built-in defaults.

# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
SPEAK_RECOMMENDATIONS=true

# ---- Calendar --------------------------------------------------------------
# Put credentials.json in this folder to use your real Google Calendar.
# Without it (or with USE_DEMO_CALENDAR=true) the demo calendar is used.
USE_DEMO_CALENDAR=false
# demo_calendar.json = busy (midterm tomorrow), demo_calendar_free.json = nothing due
DEMO_CALENDAR_FILE=demo_calendar.json

# ---- Fatigue score: what triggers the "Nodding off?" popup ------------------
AGENT_TRIGGER_SCORE=2          # points needed to open the popup
FATIGUE_WINDOW_MINUTES=10      # each point expires this long after it happened
MICROSLEEP_SECONDS=0.8         # eyes shut this long = microsleep (soft chime)
MICROSLEEP_POINTS=1
LONG_MICROSLEEP_SECONDS=10     # same closure still shut this long = upgraded
LONG_MICROSLEEP_POINTS=2
STILL_SECONDS=60               # no head/eye movement or blink this long
STILL_POINTS=2
YAWN_POINTS=0.5

# ---- Popup, snooze, alarm --------------------------------------------------
CONFIRM_SECONDS=15             # time to press "False alarm" before Claude is asked
AGENT_COOLDOWN_SECONDS=300     # quiet period after real advice (try 30 for demos)
SNOOZE_MINUTES=5
ALARM_SOUND=alarm.wav          # WAV played when the popup opens; beeps if missing

# ---- Detection tuning (press d to see the live numbers) --------------------
EAR_CLOSED_FRACTION=0.50       # "closed" = eye opening below this x your calibrated normal
EAR_DEEP_FRACTION=0.30         # "nearly shut": always counts, even when looking down
LOOK_DOWN_THRESHOLD=0.45       # gaze-down score above which lowered lids = reading
HEAD_DOWN_FACTOR=1.60          # head tilt (x your normal) that counts as reading
NOD_COMMIT_SECONDS=0.4         # eyes shut this long while upright = locked in if head drops

# ---- Window ----------------------------------------------------------------
CAMERA_INDEX=0
DISPLAY_SCALE=1.5              # window size only; doesn't slow detection
DEBUG_OVERLAY=false
